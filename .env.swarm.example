# ──────────────────────────────────────────────────────────────────
# .env untuk deploy Swarm (dipakai oleh: docker stack deploy -c alumni-stack.yml alumni)
# Taruh file ini SATU FOLDER dengan alumni-stack.yml dan nginx/
# JANGAN commit file ini ke git — isinya kredensial asli.
# ──────────────────────────────────────────────────────────────────

# Image yang sudah kamu push ke Docker Hub
DOCKER_IMAGE=<username>/alumni:1.0.0

# Generate dulu: docker run --rm <username>/alumni:1.0.0 php artisan key:generate --show
APP_KEY=<paste hasil key:generate --show di sini>
APP_NAME="Alumni Management System"
APP_URL=https://<domain-alumni-kamu>

LOG_CHANNEL=stack
LOG_LEVEL=error

# Kredensial postgres shared yang ASLI (bukan yang default docker/dev)
DB_DATABASE=alumni
DB_USERNAME=<username_postgres_asli>
DB_PASSWORD=<password_postgres_asli>

SESSION_LIFETIME=120

# Port yang di-publish nginx di host (jangan bentrok sama 8080/8083/8084 yang sudah dipakai project lain)
NGINX_PORT=8086

# Email — biarkan default log kalau belum butuh email beneran terkirim,
# atau isi SMTP asli kalau sudah ada fitur reset password / notifikasi
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@<domain-alumni-kamu>
MAIL_FROM_NAME="Alumni Management System"
